# Copy to .env for local development. Never commit real secrets.
# .env entries do not require the CREDO_ prefix; process environment variables do.

SERVER__HOST=127.0.0.1
SERVER__PORT=8080
SERVER__DEBUG=true
I18N__DIR=locales/
I18N__DEFAULT=en
DATABASES__DEFAULT__PASSWORD=change-me
APP__ENVIRONMENT=development

# Process-environment equivalents:
# CREDO_SERVER__PORT=8080
# CREDO_DATABASES__DEFAULT__PASSWORD=change-me
